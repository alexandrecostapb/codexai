<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient"
    tools:context=".Sobre">

    <ImageButton
        android:id="@+id/btnVoltar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="48dp"
        app:layout_constraintWidth_max="48dp"
        app:layout_constraintDimensionRatio="1:1"
        android:src="@drawable/outline_arrow_back_24"
        app:tint="#FFFFFF"
        android:background="@drawable/bg_botao"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:contentDescription="Voltar para o chat"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="20dp" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sobre"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:fontFamily="@font/inter_regular"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/textView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Descrição do aplicativo"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:textStyle="bold"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="O CodexAI é um aplicativo mobile que utiliza inteligência artificial para ajudar usuários a entender códigos de programação de forma simples e rápida. Nele, o usuário pode inserir uma imagem do código ou enviar um trecho de código, e o aplicativo analisa e gera uma explicação clara sobre o que aquele código faz, facilitando o aprendizado para estudantes e iniciantes em programação."
                android:textColor="#E8EBF0"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:lineSpacingMultiplier="1.2"
                android:background="@drawable/bg_novo_chat_button"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintTop_toBottomOf="@id/textView2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <TextView
                android:id="@+id/textViewDesenvolvedores"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:fontFamily="@font/inter_regular"
                android:text="Desenvolvedores"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView3" />

            <!--Arlindo-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardArlindo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_novo_chat_button"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintTop_toBottomOf="@id/textViewDesenvolvedores"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/fotoArlindo"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/arlindo_sobre"
                    android:foreground="@drawable/bg_botao"
                    android:foregroundGravity="center"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto de Arlindo Franklim"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <TextView
                    android:id="@+id/nomeArlindo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Arlindo Franklim"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_regular"
                    android:textStyle="bold"
                    android:layout_marginStart="14dp"
                    app:layout_constraintTop_toTopOf="@id/fotoArlindo"
                    app:layout_constraintStart_toEndOf="@id/fotoArlindo"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/linkGitArlindo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_regular"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:text="GitHub"
                    android:textColor="#4183C4"
                    android:textSize="14sp"
                    app:layout_constraintStart_toEndOf="@id/fotoArlindo"
                    app:layout_constraintTop_toBottomOf="@id/nomeArlindo" />

                <TextView
                    android:id="@+id/divisorArlindo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" | "
                    android:textColor="#888888"
                    android:textSize="14sp"
                    android:layout_marginStart="6dp"
                    app:layout_constraintTop_toTopOf="@id/linkGitArlindo"
                    app:layout_constraintBottom_toBottomOf="@id/linkGitArlindo"
                    app:layout_constraintStart_toEndOf="@id/linkGitArlindo" />

                <TextView
                    android:id="@+id/linkLinkedinArlindo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_regular"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:text="LinkedIn"
                    android:textColor="#0077B5"
                    android:textSize="14sp"
                    app:layout_constraintStart_toEndOf="@id/divisorArlindo"
                    app:layout_constraintTop_toTopOf="@id/linkGitArlindo"
                    app:layout_constraintBottom_toBottomOf="@id/linkGitArlindo" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--Iasmim-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardIasmim"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_novo_chat_button"
                android:padding="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintTop_toBottomOf="@id/cardArlindo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/fotoIasmim"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/iasmim_sobre"
                    android:foreground="@drawable/bg_botao"
                    android:foregroundGravity="center"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto de Iasmim Anahí"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <TextView
                    android:id="@+id/nomeIasmim"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Iasmim Anahí"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_regular"
                    android:textStyle="bold"
                    android:layout_marginStart="14dp"
                    app:layout_constraintTop_toTopOf="@id/fotoIasmim"
                    app:layout_constraintStart_toEndOf="@id/fotoIasmim"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/linkGitIasmim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_regular"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:text="GitHub"
                    android:textColor="#4183C4"
                    android:textSize="14sp"
                    app:layout_constraintStart_toEndOf="@id/fotoIasmim"
                    app:layout_constraintTop_toBottomOf="@id/nomeIasmim" />

                <TextView
                    android:id="@+id/divisorIasmim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" | "
                    android:textColor="#888888"
                    android:textSize="14sp"
                    android:layout_marginStart="6dp"
                    app:layout_constraintTop_toTopOf="@id/linkGitIasmim"
                    app:layout_constraintBottom_toBottomOf="@id/linkGitIasmim"
                    app:layout_constraintStart_toEndOf="@id/linkGitIasmim" />

                <TextView
                    android:id="@+id/linkLinkedinIasmim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_regular"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:text="LinkedIn"
                    android:textColor="#0077B5"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@id/linkGitIasmim"
                    app:layout_constraintStart_toEndOf="@id/divisorIasmim"
                    app:layout_constraintTop_toTopOf="@id/linkGitIasmim" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--Kauã-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardKaua"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_novo_chat_button"
                android:padding="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintTop_toBottomOf="@id/cardIasmim"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/fotoKaua"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/kaua_sobre"
                    android:foreground="@drawable/bg_botao"
                    android:foregroundGravity="center"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto de Kauã Lucas"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <TextView
                    android:id="@+id/nomeKaua"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Kauã Lucas"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_regular"
                    android:textStyle="bold"
                    android:layout_marginStart="14dp"
                    app:layout_constraintTop_toTopOf="@id/fotoKaua"
                    app:layout_constraintStart_toEndOf="@id/fotoKaua"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/linkGitKaua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_regular"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:text="GitHub"
                    android:textColor="#4183C4"
                    android:textSize="14sp"
                    app:layout_constraintStart_toEndOf="@id/fotoKaua"
                    app:layout_constraintEnd_toStartOf="@id/divisorKaua"
                    app:layout_constraintTop_toBottomOf="@id/nomeKaua" />

                <TextView
                    android:id="@+id/divisorKaua"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text=" | "
                    android:textColor="#888888"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="@id/linkGitKaua"
                    app:layout_constraintBottom_toBottomOf="@id/linkGitKaua"
                    app:layout_constraintStart_toEndOf="@id/linkGitKaua"
                    app:layout_constraintEnd_toStartOf="@id/linkLinkedinKaua" />

                <TextView
                    android:id="@+id/linkLinkedinKaua"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center_vertical"
                    android:text="LinkedIn"
                    android:textColor="#0077B5"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="@id/linkGitKaua"
                    app:layout_constraintBottom_toBottomOf="@id/linkGitKaua"
                    app:layout_constraintStart_toEndOf="@id/divisorKaua"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/textView8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:fontFamily="@font/inter_regular"
                android:text="Orientador"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardKaua" />

            <!-- Alexandre-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardAlexandre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_novo_chat_button"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintTop_toBottomOf="@id/textView8"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/fotoAlexandre"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/alexandre_sobre"
                    android:foreground="@drawable/bg_botao"
                    android:foregroundGravity="center"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto de Alexandre Costa"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <TextView
                    android:id="@+id/nomeAlexandre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Alexandre Costa"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_regular"
                    android:textStyle="bold"
                    android:layout_marginStart="14dp"
                    app:layout_constraintTop_toTopOf="@id/fotoAlexandre"
                    app:layout_constraintStart_toEndOf="@id/fotoAlexandre"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/linkGitAlexandre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_regular"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:text="GitHub"
                    android:textColor="#4183C4"
                    android:textSize="14sp"
                    app:layout_constraintStart_toEndOf="@id/fotoAlexandre"
                    app:layout_constraintTop_toBottomOf="@id/nomeAlexandre" />

                <TextView
                    android:id="@+id/divisorAlexandre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" | "
                    android:textColor="#888888"
                    android:textSize="14sp"
                    android:layout_marginStart="6dp"
                    app:layout_constraintTop_toTopOf="@id/linkGitAlexandre"
                    app:layout_constraintBottom_toBottomOf="@id/linkGitAlexandre"
                    app:layout_constraintStart_toEndOf="@id/linkGitAlexandre" />

                <TextView
                    android:id="@+id/linkLinkedinAlexandre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_regular"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:text="LinkedIn"
                    android:textColor="#0077B5"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="@id/linkGitAlexandre"
                    app:layout_constraintBottom_toBottomOf="@id/linkGitAlexandre"
                    app:layout_constraintStart_toEndOf="@id/divisorAlexandre" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>