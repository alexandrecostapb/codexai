<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient"
    tools:context=".Sobre">

    <ImageButton
        android:id="@+id/btnVoltar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="48dp"
        app:layout_constraintWidth_max="48dp"
        app:layout_constraintDimensionRatio="1:1"
        android:src="@drawable/outline_arrow_back_24"
        app:tint="#FFFFFF"
        android:background="@drawable/bg_botao"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:contentDescription="Voltar para o chat"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="20dp" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sobre"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:fontFamily="@font/inter_regular"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Descrição do aplicativo"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="@font/inter_regular"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/textView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="O CodexAI é um aplicativo mobile que utiliza inteligência artificial para ajudar usuários a entender códigos de programação de forma simples e rápida. Nele, o usuário pode inserir uma imagem do código ou enviar um trecho de código, e o aplicativo analisa e gera uma explicação clara sobre o que aquele código faz, facilitando o aprendizado para estudantes e iniciantes em programação."
        android:textColor="#E8EBF0"
        android:textSize="16sp"
        android:fontFamily="@font/inter_regular"
        android:lineSpacingMultiplier="1.2"
        android:background="@drawable/bg_novo_chat_button"
        android:padding="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/textView2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Desenvolvedores"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="@font/inter_regular"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/textView3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nome"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center_vertical"
        android:background="@drawable/bg_novo_chat_button"
        android:paddingVertical="14dp"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/textView4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nome "
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center_vertical"
        android:background="@drawable/bg_novo_chat_button"
        android:paddingVertical="14dp"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/textView5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nome"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center_vertical"
        android:background="@drawable/bg_novo_chat_button"
        android:paddingVertical="14dp"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/textView6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Orientador"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="@font/inter_regular"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/textView7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Orientador"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center_vertical"
        android:background="@drawable/bg_novo_chat_button"
        android:paddingVertical="14dp"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/textView8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>