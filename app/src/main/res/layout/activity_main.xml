<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient"
    tools:context=".MainActivity">

    <!-- Tela principal -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tela_do_chat"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- botão historico -->
        <ImageButton
            android:id="@+id/btnHistorico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_botao"
            android:src="@drawable/baseline_menu_24"
            app:tint="#FFFFFF"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:contentDescription="Abrir histórico"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_margin="12dp"/>

        <!-- Lista de mensagens -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mensagemRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:padding="8dp"
            app:layout_constraintBottom_toTopOf="@id/promptEditText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnHistorico" />

        <!-- Preview da imagem -->
        <ImageView
            android:id="@+id/imagemPreview"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="8dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/promptEditText" />



        <!-- Botão imagem -->
        <ImageButton
            android:id="@+id/imagemButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            app:layout_constraintWidth_max="48dp"
            app:layout_constraintDimensionRatio="1:1"
            android:background="@drawable/bg_botao"
            android:src="@drawable/outline_add_24"
            app:tint="#FFFFFF"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:elevation="10dp"
            android:contentDescription="Selecionar imagem"
            app:layout_constraintStart_toStartOf="@id/promptEditText"
            app:layout_constraintEnd_toEndOf="@id/promptEditText"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintTop_toTopOf="@id/promptEditText"
            app:layout_constraintBottom_toBottomOf="@id/promptEditText"
            android:layout_marginStart="6dp"/>

        <!-- Botão enviar -->
        <ImageButton
            android:id="@+id/enviarButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minWidth="42dp"
            android:background="@drawable/bg_botao"
            android:src="@drawable/outline_assistant_navigation_24"
            app:tint="#FFFFFF"
            android:rotation="45"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:elevation="10dp"
            android:contentDescription="Enviar mensagem"
            app:layout_constraintEnd_toEndOf="@id/promptEditText"
            app:layout_constraintTop_toTopOf="@id/promptEditText"
            app:layout_constraintBottom_toBottomOf="@id/promptEditText"
            android:layout_marginEnd="8dp"/>

        <!-- Campo de texto -->
        <EditText
            android:id="@+id/promptEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Pergunte qualquer coisa"
            android:textColorHint="#D4DAE2"
            android:textColor="#FFFFFF"
            android:minHeight="56dp"
            android:paddingStart="60dp"
            android:paddingEnd="60dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/fundo_chat"
            android:fontFamily="@font/inter_regular"
            android:textSize="17sp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- botão sobre-->
        <ImageButton
            android:id="@+id/btnSobre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_botao"
            android:src="@drawable/baseline_info_24"
            app:tint="#FFFFFF"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:contentDescription="Informações sobre o app"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_min="48dp"
            app:layout_constraintHeight_min="48dp"
            android:layout_margin="12dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Menu lateral (Drawer) -->
    <LinearLayout
        android:id="@+id/menu_do_historico"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1F2E48"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNovoChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:layout_margin="12dp"
            android:text="Novo Chat"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:icon="@drawable/icone_adicionar_chat"
            app:iconTint="@null"
            app:iconGravity="textEnd"
            app:iconPadding="8dp"
            app:backgroundTint="@null"
            android:background="@drawable/bg_novo_chat_button"
            android:textSize="16sp" />



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="18dp"
            android:background="@drawable/bg_lista_chats">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerHistorico"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>